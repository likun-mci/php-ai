# 仓库内一律用 LF 存储，检出时不改写；避免同一文件在不同机器上产生整文件级 diff
* text=auto eol=lf

# 明确按文本处理的类型
*.php    text eol=lf
*.md     text eol=lf
*.json   text eol=lf
*.yml    text eol=lf
*.xml    text eol=lf
*.neon   text eol=lf
.gitattributes text eol=lf
.gitignore     text eol=lf

# 二进制，永不改写
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.zip binary
