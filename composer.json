{
    "name": "likun-mci/php-ai",
    "description": "框架无关的 PHP AI 标准库：一套接口访问 40 个国内外主流 AI 平台（通义千问 / 豆包 / 文心一言 / 智谱 GLM / Kimi / 混元 / 星火 / DeepSeek / OpenAI / Claude / Gemini / Grok / Mistral 等），内置流式输出、Agent 工具调用循环、AI 代码编辑协议与安全网页抓取。",
    "type": "library",
    "keywords": [
        "ai",
        "llm",
        "openai",
        "claude",
        "anthropic",
        "gemini",
        "deepseek",
        "qwen",
        "tongyi",
        "dashscope",
        "doubao",
        "volcengine",
        "ernie",
        "qianfan",
        "zhipu",
        "glm",
        "moonshot",
        "kimi",
        "hunyuan",
        "spark",
        "minimax",
        "grok",
        "mistral",
        "openrouter",
        "siliconflow",
        "ollama",
        "agent",
        "sdk",
        "stream",
        "php-ai",
        "llm-sdk"
    ],
    "homepage": "https://github.com/likun-mci/php-ai",
    "license": "MIT",
    "authors": [
        {
            "name": "likun-mci",
            "email": "likun.work@qq.com",
            "homepage": "https://likun.work",
            "role": "Developer"
        }
    ],
    "support": {
        "email": "likun.work@qq.com",
        "issues": "https://github.com/likun-mci/php-ai/issues",
        "source": "https://github.com/likun-mci/php-ai"
    },
    "require": {
        "php": ">=7.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*"
    },
    "autoload": {
        "psr-4": {
            "Ai\\": "src/"
        },
        "exclude-from-classmap": [
            "examples.php",
            "examples_agent.php",
            "examples_claude_cli.php",
            "examples_custom.php",
            "examples_models.php",
            "examples_platforms.php",
            "examples_stream.php"
        ]
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "minimum-stability": "stable",
    "scripts": {
        "test": [
            "php tests/smoke_test.php",
            "php tests/stream_test.php",
            "php tests/tools_test.php",
            "php tests/search_test.php",
            "php tests/lib_test.php",
            "php tests/cli_test.php",
            "php tests/cli_session_test.php",
            "php tests/ssrf_test.php",
            "php tests/agent_runtime_test.php",
            "php tests/agent_advanced_test.php",
            "php tests/agent_task_test.php"
        ],
        "analyse": "phpstan analyse --memory-limit=512M",
        "compat": "phpcs -p --standard=PHPCompatibility --runtime-set testVersion 7.1- --extensions=php --ignore='*/vendor/*' .",
        "check": [
            "@test",
            "@analyse",
            "@compat"
        ]
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpcompatibility/php-compatibility": "^9.3",
        "phpstan/phpstan": "^1.10",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "suggest": {
        "ext-openssl": "使用 WebSocket 语音接口（wss://，如讯飞 TTS/ASR）时必需；对话、图像、HTTP 语音等其余能力不需要"
    }
}
