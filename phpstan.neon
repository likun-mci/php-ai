# 静态分析配置
#
# level 逐级往上爬，每级修干净再进下一级——能长期维持绿灯的等级才有意义。
#
# 5 → 6 这一步补齐了全部 phpdoc 类型（543 处）。本库为兼容 PHP 7.2 不能用
# 类型化属性，类型信息只能写在 phpdoc 里，因此这一级的收益是实打实的：
# 使用方 IDE 能正确补全，改动时的类型错误也能被静态分析拦住。
# 过程中确实抓到了几处我原本猜错的类型（如 EditExecutor::applyStrReplace()
# 实际返回数组而非字符串），说明这一级不只是形式功夫。
#
# 6 → 7 查联合类型上的成员访问，抓到几个真会炸的边界：
# base64_encode(file_get_contents()) 在文件读不到时返回 false，PHP 8 上直接
# TypeError；json_encode 失败返回 false 被当字符串用；curl_exec 的 bool 分支
# 被喂给 json_decode。
#
# 7 → 8 查 null 安全，同样都是真问题：preg_replace 在 PCRE 回溯超限时返回 null
# （抓大页面时真会触发），之后 strip_tags(null) 在 PHP 8.1 起 deprecated、
# 9 会是 TypeError，整段内容提取会静默变成空。
#
# **就停在 8。** level 9 是「禁止对 mixed 做任何操作」，而本库处理的正是各家
# 平台返回的任意 JSON 载荷——数据本身就是 mixed，那 269 条几乎全要靠
# assert 或强制转型去哄静态分析，既不增加正确性也让代码更难读。
parameters:
    level: 8
    paths:
        - src

    # 不把 phpdoc 里的类型当成铁定事实。
    # 本库大量属性只在 @var 里标了类型（PHP 7.2 不支持类型化属性），
    # 而运行时它们在被赋值前确实是 null，`if (!$this->model)` 这类保护是必要的。
    # 打开这个开关后 PHPStan 才不会把这些防御性判断报成「永远为假」。
    treatPhpDocTypesAsCertain: false

    ignoreErrors:
        # curl 句柄在 PHP 7.2 是 resource、8.0+ 是 CurlHandle。本库两者都要支持，
        # 因此 buildHandle() 的返回类型如实标成联合类型；PHPStan 按 PHP 8 语义分析，
        # 会认为 resource 分支不合法。这是跨版本兼容的必然结果，不是缺陷。
        -
            message: '#expects CurlHandle, CurlHandle\|resource given#'
            path: src/Transport/CurlTransport.php

        # create() 是文档化的工厂方法，子类沿用同样的构造签名，new static() 是刻意为之
        -
            message: '#Unsafe usage of new static\(\)#'
            path: src/Cli/ClaudeCode.php

        # drainPipes() 内部会把 turnDone 置为 true（见 handleLine），
        # PHPStan 不跟踪被调方法对属性的写入，这里是误报
        -
            message: '#If condition is always false#'
            path: src/Cli/ClaudeCodeSession.php

