# 静态分析配置
#
# level 逐级往上爬，每级修干净再进下一级——能长期维持绿灯的等级才有意义。
#
# 5 → 6 这一步补齐了全部 phpdoc 类型（543 处）。本库为兼容 PHP 7.2 不能用
# 类型化属性，类型信息只能写在 phpdoc 里，因此这一级的收益是实打实的：
# 使用方 IDE 能正确补全，改动时的类型错误也能被静态分析拦住。
# 过程中确实抓到了几处我原本猜错的类型（如 EditExecutor::applyStrReplace()
# 实际返回数组而非字符串），说明这一级不只是形式功夫。
#
# 下一级是 7（约 37 条，主要是联合类型上的成员访问）。
parameters:
    level: 6
    paths:
        - src

    # 不把 phpdoc 里的类型当成铁定事实。
    # 本库大量属性只在 @var 里标了类型（PHP 7.2 不支持类型化属性），
    # 而运行时它们在被赋值前确实是 null，`if (!$this->model)` 这类保护是必要的。
    # 打开这个开关后 PHPStan 才不会把这些防御性判断报成「永远为假」。
    treatPhpDocTypesAsCertain: false

    ignoreErrors:
        # create() 是文档化的工厂方法，子类沿用同样的构造签名，new static() 是刻意为之
        -
            message: '#Unsafe usage of new static\(\)#'
            path: src/Cli/ClaudeCode.php

        # drainPipes() 内部会把 turnDone 置为 true（见 handleLine），
        # PHPStan 不跟踪被调方法对属性的写入，这里是误报
        -
            message: '#If condition is always false#'
            path: src/Cli/ClaudeCodeSession.php

